{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(pytest*)"
    ],
    "ask": [
      "Bash(gcloud*)",
      "Bash(gsutil*)",
      "Bash(earthengine*)",
      "Bash(gh workflow run*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*.local)",
      "Read(**/.env.local)",
      "Read(**/*service-account*.json)",
      "Bash(git push* main*)",
      "Bash(gh pr merge*)"
    ]
  }
}
